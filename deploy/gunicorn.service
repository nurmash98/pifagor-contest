[Unit]
Description=Pifagor Contest (gunicorn)
After=network.target postgresql.service

[Service]
User=pifagor
Group=pifagor
WorkingDirectory=/opt/pifagor-contest
EnvironmentFile=/etc/pifagor/pifagor.env
CacheDirectory=pifagor
# 3 процесса × 4 потока. Код учеников запускается через sudo под пользователем pifagorbox,
# поэтому НЕ включайте NoNewPrivileges — sudo перестанет работать.
ExecStart=/opt/pifagor-contest/venv/bin/gunicorn --workers 3 --worker-class gthread --threads 4 --timeout 60 --bind 127.0.0.1:8000 pifagor_contest.wsgi:application
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
